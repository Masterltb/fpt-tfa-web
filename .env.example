# ==============================================================================
# TFA Environment Variables
# Copy to .env and fill in values
# ==============================================================================

# Database
DATABASE_URL=postgresql://tfa:tfa_local_dev@localhost:5432/tfa_dev

# Firebase Auth
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Application
APP_ENV=development
APP_SECRET_KEY=change-this-in-production
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Matching Engine
MATCHING_ENGINE=ortools
MATCHING_TIMEOUT_SECONDS=120

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=.csv,.xlsx,.xls
