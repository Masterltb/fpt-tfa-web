# ==============================================================================
# TFA Environment Variables
# Copy to .env and fill in values
# ==============================================================================

# Database (Supabase PostgreSQL / Local Postgres)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Firebase Auth
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Application
APP_ENV=development
APP_SECRET_KEY=change-this-in-production
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Matching Engine
MATCHING_ENGINE=ortools
MATCHING_TIMEOUT_SECONDS=120

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=.csv,.xlsx,.xls
